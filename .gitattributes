* text=auto eol=lf

# Binary
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.xls binary

# Snapshot raw — file SDMX/CSV piccoli restano text per diff leggibili.
# LFS solo per archive PDF/XLS pesanti delle proiezioni storiche.
data/raw/istat/archive/**/*.pdf filter=lfs diff=lfs merge=lfs -text
data/raw/istat/archive/**/*.xls filter=lfs diff=lfs merge=lfs -text
data/raw/istat/archive/**/*.xlsx filter=lfs diff=lfs merge=lfs -text
